CREATE TABLE employees
(
    empNo INT PRIMARY KEY,
    empName VARCHAR(30),
    empDesignation VARCHAR(20),
    empSalary INT,
    empIsPermenant BIT,
    empDept INT,

    CONSTRAINT fk_empDept
        FOREIGN KEY (empDept)
        REFERENCES depts(deptNo)
);

